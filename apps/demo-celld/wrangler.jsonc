{
  "name": "demo-celld",
  "main": "worker.js",
  "compatibility_date": "2026-01-01",
  "rules": [{ "type": "Text", "globs": ["**/*.html"] }],
  "durable_objects": {
    "bindings": [{ "name": "ITEMS", "class_name": "Items" }]
